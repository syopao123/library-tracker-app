@using LibraryTrackerApp.Data

<div class="card p-0">

    <img src="@Book.ImageUrl" class="card-img-top" alt="@Book.Title"

    <div class="card-body">

        <div class="row pb-3">
            @switch (Book.Status)
            {
                case ReadingStatus.ToRead:
                    <div><span class="badge rounded-pill px-3 py-2 to-read">To Read</span></div>
                    break;

                case ReadingStatus.Reading:
                    <div><span class="badge rounded-pill px-3 py-2 reading">Reading</span></div>
                    break;

                case ReadingStatus.Finished:
                    <div><span class="badge rounded-pill px-3 py-2 finished">Finished</span></div>
                    break;
            }

        </div>

        <div class="card-title">
            <h5>@Book.Title</h5>
        </div>

        <p class="card-text">@Book.Genre</p>

    </div>
    <div class="card-footer pb-4">
        @if (Book.Status == ReadingStatus.Finished)
        {
            var userRating = Book.Rating;
            var starCount = 5 - userRating;

            for (var i = 0; i < userRating; i++)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#f7d052" class="bi bi-star-fill"
                     viewBox="0 0 16 16">
                    <path
                    d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                </svg>
            }

            for (var i = 0; i < starCount; i++)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#f7d052" class="bi bi-star"
                     viewBox="0 0 16 16">
                    <path
                    d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.56.56 0 0 0-.163-.505L1.71 6.745l4.052-.576a.53.53 0 0 0 .393-.288L8 2.223l1.847 3.658a.53.53 0 0 0 .393.288l4.052.575-2.906 2.77a.56.56 0 0 0-.163.506l.694 3.957-3.686-1.894a.5.5 0 0 0-.461 0z" />
                </svg>
            }
        }
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
        border: 1px solid rgb(240, 240, 240) !important;
        width: 20rem;
        height: 100%;
    }
    .card-img-top {
        width: 100%;
        height: 400px;
        object-fit: cover;
    }
    .card, .card-img-top {
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }
    .card-text {
        color: rgb(110, 110, 110);
        font-size: 14px;
    }
    .card, .card-footer {
        border: none;
    }
    .card-footer {
        background: transparent;
    }
    .card-body .to-read {
        color: rgb(95, 62, 0) !important;
        background-color: rgb(241, 220, 179) !important;
    }
    .card-body .reading {
        color: rgb(16, 80, 58) !important;
        background-color: rgb(179, 241, 209) !important;
    }
    .card-body .finished {
        color: rgb(73, 73, 73) !important;
        background-color: rgb(233, 233, 233) !important;
    }
</style>


@code {

    [Parameter, EditorRequired]
    public Book Book { get; set; }
}
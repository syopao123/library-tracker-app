@using System.Diagnostics
@using LibraryTrackerApp.Data

@inject MockDbService Db

<EditForm Model="Book" OnValidSubmit="Submit" FormName="AddBookForm" class="p-0 p-lg-5">
    <DataAnnotationsValidator />

    <div class="row mb-3">
        <div class="col">
            <label for="newBookTitle" class="form-label">Title <span class="text-danger">*</span></label>
            <InputText @bind-Value="Book.Title" class="form-control" id="newBookTitle"
                       placeholder="e.g. The Wind-Up Bird Chronicle" />
            <ValidationMessage For="@(() => Book.Title)" class="text-danger small mt-2" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col">
            <label for="newBookAuthor" class="form-label">Author <span class="text-danger">*</span></label>
            <InputText @bind-Value="Book.Author" class="form-control" id="newBookAuthor"
                       placeholder="e.g. Haruki Murakami" />
            <ValidationMessage For="@(() => Book.Author)" class="text-danger small mt-2" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col">
            <label for="newBookImageUrl" class="form-label">Image Url</label>
            <InputText @bind-Value="NewBookImageUrl" class="form-control" id="newBookImageUrl"
                       placeholder="Enter book cover image url ..." />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col">
            <label for="newBookGenre" class="form-label">Genre</label>
            <InputSelect class="form-select" @bind-Value="Book.Genre">
                <option value="" selected>Select a genre ...</option>
                @foreach (var genre in Db.Genres!) {
                    <option value="@genre">@genre</option>
                }
            </InputSelect>
        </div>
        <div class="col">
            <label for="newBookStatus" class="form-label">Status</label>
            <InputSelect class="form-select" @bind-Value="Book.Status" @bind-Value:after="OnStatusChange">
                <option value="@ReadingStatus.ToRead" selected>To Read</option>
                <option value="@ReadingStatus.Reading">Reading</option>
                <option value="@ReadingStatus.Finished">Finished</option>
            </InputSelect>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-6">
            <label for="newBookRating" class="form-label">Rating</label>
            <InputSelect class="form-select" @bind-Value="Book.Rating" disabled="@isRatingDisabled">
                <option value="" selected>Select a rating ...</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
            </InputSelect>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col">
            <label for="newBookPersonalNotes" class="form-label">Personal Notes</label>
            <InputTextArea id="newBookPersonalNotes" @bind-Value="Book.PersonalNotes" class="form-control" rows="5" />
        </div>
    </div>
    <div class="row">
        @if (isLoading)
        {
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        }
        <div class="col d-flex gap-2 justify-content-end">
            <button type="button" class="btn px-4 cancelBtn" data-bs-dismiss="modal" disabled="@isLoading">Cancel</button>
            <button type="submit" class="btn px-3 saveBookBtn" disabled=@isLoading>
                <div class="d-flex align-items-center gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-floppy"
                     viewBox="0 0 16 16">
                    <path d="M11 2H9v3h2z" />
                    <path
                    d="M1.5 0h11.586a1.5 1.5 0 0 1 1.06.44l1.415 1.414A1.5 1.5 0 0 1 16 2.914V14.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 14.5v-13A1.5 1.5 0 0 1 1.5 0M1 1.5v13a.5.5 0 0 0 .5.5H2v-4.5A1.5 1.5 0 0 1 3.5 9h9a1.5 1.5 0 0 1 1.5 1.5V15h.5a.5.5 0 0 0 .5-.5V2.914a.5.5 0 0 0-.146-.353l-1.415-1.415A.5.5 0 0 0 13.086 1H13v4.5A1.5 1.5 0 0 1 11.5 7h-7A1.5 1.5 0 0 1 3 5.5V1H1.5a.5.5 0 0 0-.5.5m3 4a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5V1H4zM3 15h10v-4.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5z" />
                </svg>
                <span>Save Book</span>
                </div>
            </button>
        </div>
    </div>

</EditForm>

@code {

    [Parameter]
    public EventCallback OnBookAdded { get; set; }

    [SupplyParameterFromForm]
    private Book? Book { get; set; }

    private string NewBookImageUrl { get; set; } = "";

    private bool isRatingDisabled = true;

    private bool isLoading = false;

    protected override void OnInitialized()
    {
        ResetBook();
    }

    private void ResetBook() {
        Book = new Book {
            Title = "",
            Author = "",
            Rating = null
        };
        NewBookImageUrl = "";
    }

    private void OnStatusChange()
    {
        if (Book!.Status == ReadingStatus.Finished)
        {
            isRatingDisabled = false;
        }
        else
        {
            isRatingDisabled = true;
            Book.Rating = null;
        }
    }

    private async Task Submit()
    {
        Book!.ImageUrl = GetImageUrl();
        Db.Books.Add(Book);
        isLoading = true;
        await OnBookAdded.InvokeAsync();
        isLoading = false;
        ResetBook();
    }

    private string GetImageUrl() {

        bool isUri = Uri.TryCreate(NewBookImageUrl, UriKind.Absolute, out Uri uriResult);

        bool imageIsValidUrl = isUri && (uriResult.Scheme == Uri.UriSchemeHttp || uriResult.Scheme == Uri.UriSchemeHttps);

        if (imageIsValidUrl) {
            return NewBookImageUrl;
        } else {
            return Book.ImageUrl;
        }
    }

}
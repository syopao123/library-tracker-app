@page "/"
@using LibraryTrackerApp.Data
@using LibraryTrackerApp.Pages.Components

<PageTitle>My Library</PageTitle>

<div class="container-fluid px-5 mb-5">

    <div class="mt-5 d-flex justify-content-between">

        @* Status and Genre filter buttons *@
        <div class="d-flex gap-3">
            <div class="d-flex align-items-end justify-content-center gap-2">
                <label class="form-label">Status:</label>
                <select class="form-select" aria-label="Default select example">
                    <option selected @onclick='() => FilterBooks("All")'>All</option>
                    <option value="ToRead" @onclick='() => FilterBooks("To Read")'>To Read</option>
                    <option value="Reading" @onclick='() => FilterBooks("Reading")'>Reading</option>
                    <option value="Finished" @onclick='() => FilterBooks("Finished")'>Finished</option>
                </select>
            </div>
        </div>

        @* Add Book button *@
        <div>
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addBookModal">
                <span class="d-flex gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor"
                         class="bi bi-plus" viewBox="0 0 16 16">
                        <path
                        d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                    </svg>
                    <span>Add Book</span>
                </span>
            </button>
        </div>

        @* Modal *@
        <div class="modal fade" id="addBookModal" tabindex="-1" aria-labelledby="addBookModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="addBookModalLabel">Add New Book</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="p-5">
                            <AddBookForm Db=Db OnBookAdded="HandleBookAdd"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Book cards *@
    <div class="row mt-4 gap-4 justify-content-center justify-content-lg-start">
        @if (books != null)
        {
            foreach (var book in books)
            {
                <BookCard Book="book" />
            }
        }
    </div>

</div>

<style>
    .dropdown-toggle:hover, .dropdown-toggle:active, .dropdown-toggle:focus {
        color: white !important;
    }
    .dropdown-toggle:focus {
        box-shadow: none;
    }
</style>

@code {

    private MockDb Db = new();
    private List<Book>? books { get; set; }

    private string currentStatusFilter { get; set; } = "All";
    private string currentGenreFilter { get; set; } = "All";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        books = new List<Book>(Db.Books);
    }

    public async Task HandleBookAdd() {
        // Simulate mock async
        await Task.Delay(1000);
        books = new List<Book>(Db.Books);
    }

    private void FilterBooks(string status)
    {
        currentStatusFilter = status;
        var filteredBooks = new List<Book>();

        if (status.Equals("All"))
        {
            books = Db.Books;
        }
        else
        {
            foreach (var book in Db.Books)
            {
                switch (status)
                {
                    case "To Read":
                        if (book.Status == ReadingStatus.ToRead)
                        {
                            filteredBooks.Add(book);
                        }
                        break;

                    case "Reading":
                        if (book.Status == ReadingStatus.Reading)
                        {
                            filteredBooks.Add(book);
                        }
                        break;

                    case "Finished":
                        if (book.Status == ReadingStatus.Finished)
                        {
                            filteredBooks.Add(book);
                        }
                        break;
                }
            }
            books = filteredBooks;
        }
    }
}
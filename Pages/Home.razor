@page "/"
@using LibraryTrackerApp.Data
@using LibraryTrackerApp.Pages.Components

<PageTitle>My Library</PageTitle>

<div class="container-fluid p-5">

    <div class="row justify-content-between">
        @* Status and Genre filter buttons *@
        <div class="col-auto">
            <div class="d-flex flex-row align-items-end gap-3">
                <label class="form-label d-none d-sm-block">Status:</label>
                <select class="form-select" aria-label="Default select example" @onchange="FilterBooks">
                    <option value="All" selected>All</option>
                    <option value="ToRead">To Read</option>
                    <option value="Reading">Reading</option>
                    <option value="Finished">Finished</option>
                </select>
            </div>
        </div>

        @* Add Book button *@
        <div class="col-auto">
            <button type="button" class="btn btn-success addBookBtn" data-bs-toggle="modal"
                    data-bs-target="#addBookModal">
                <span class="d-flex gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor"
                         class="bi bi-plus" viewBox="0 0 16 16">
                        <path
                        d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                    </svg>
                    <span class="d-none d-sm-block">Add Book</span>
                </span>
            </button>
        </div>
    </div>

    @* Modal *@
    <div class="modal fade" id="addBookModal" tabindex="-1" aria-labelledby="addBookModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="addBookModalLabel">Add New Book</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <AddBookForm Db=Db OnBookAdded="HandleBookAdd" />
                </div>
            </div>
        </div>
    </div>

    @* Book cards *@
    <div class="row mt-4 gap-4 justify-content-center justify-content-lg-start">
        @if (books != null)
        {
            foreach (var book in books)
            {
                <BookCard Book="book" />
            }
        }
    </div>

</div>

<style>
    .dropdown-toggle:hover, .dropdown-toggle:active, .dropdown-toggle:focus {
        color: white !important;
    }
    .dropdown-toggle:focus {
        box-shadow: none;
    }
    .addBookBtn {
        border-radius: 9px;
        background-color: #006a61;
    }
    .addBookBtn:hover {
        background-color: rgb(0, 117, 108);
    }
    .addBookBtn:focus:not(:focus-visible) {
        box-shadow: none;
        outline: none;
    }
</style>

@code {

    private MockDb Db = new();
    private List<Book>? books { get; set; }

    private string currentStatusFilter { get; set; } = "All";
    private string currentGenreFilter { get; set; } = "All";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        books = new List<Book>(Db.Books);
    }

    public async Task HandleBookAdd() {
        // Simulate mock async
        await Task.Delay(1000);
        books = new List<Book>(Db.Books);
    }

    private void FilterBooks(ChangeEventArgs e)
    {
        currentStatusFilter = 
            e.Value?.ToString() is null || e.Value!.ToString().IsWhiteSpace() || e.Value.ToString()!.Length == 0 ? "All" : e.Value!.ToString()!;

        books = currentStatusFilter.Equals("All") ? Db.Books : 
                                        Db.Books.Where((b) => b.Status.ToString().Equals(currentStatusFilter)).ToList();
    }
}
@page "/"

@using LibraryTrackerApp.Services
@using LibraryShared.classes
@using LibraryShared.dtos
@using LibraryShared.enums
@using LibraryTrackerApp.Pages.Components

@inject BookService _bookService

@attribute [Authorize]

<PageTitle>My Library</PageTitle>

@* Content *@
<div class="container-fluid">
    <div class="p-3 p-lg-5">

        @if (CurrentView == HomePageView.UserLibrary)
        {
            @if (isLoading)
            {
                <div class="row justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <UserLibrary UserBooks="UserBooks" OnUpdateLibrary="GetUserBooksAsync" OnSearchBook="ShowSearchBook" />
            }
        }
        else if (CurrentView == HomePageView.SearchBook)
        {
            <SearchBook OnReturnToLibrary="ToggleShowLibrary" OnBookSelect="HandleBookSelect" />
        } 
        else if (CurrentView == HomePageView.AddBookForm) 
        {
            <AddBookForm Doc=SelectedDoc OnReturnToSearch="HandleReturnToSearch" OnSubmitBook="ToggleShowLibrary" />
        }

    </div>
</div>

@code {

    private enum HomePageView { UserLibrary, SearchBook, AddBookForm }
    private HomePageView CurrentView { get; set; } = HomePageView.UserLibrary;

    private List<BookDto>? UserBooks { get; set; }

    private OpenLibraryDoc? SelectedDoc { get; set; }

    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = !isLoading;
        UserBooks = await _bookService.GetUserBooksAsync();
        isLoading = !isLoading;
    }
    
    private async Task GetUserBooksAsync() {
        isLoading = !isLoading;
        UserBooks = await _bookService.GetUserBooksAsync();
        isLoading = !isLoading;
        StateHasChanged();
    }

    private void HandleReturnToSearch() {
        CurrentView = HomePageView.SearchBook;
    }

    private void ShowSearchBook() {
        CurrentView = HomePageView.SearchBook;
    }

    private void HandleBookSelect(OpenLibraryDoc doc) {
        SelectedDoc = doc;
        CurrentView = HomePageView.AddBookForm;
    }

    private async Task ToggleShowLibrary(AddBookDto book)
    {
        CurrentView = HomePageView.UserLibrary;

        // Refresh library if a new book was added
        if (book is not null)
            await GetUserBooksAsync();
        
        StateHasChanged();
    }
}
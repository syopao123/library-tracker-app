@page "/"

@using LibraryTrackerApp.Services
@using LibraryShared.classes
@using LibraryShared.dtos
@using LibraryShared.enums
@using LibraryTrackerApp.Pages.Components

@inject BookService _bookService

@attribute [Authorize]

<PageTitle>My Library</PageTitle>

@* Content *@
<div class="container-fluid">
    <div class="p-3 p-lg-5">

        @if (isShowingLibrary && !isSearchingBook && !isAddingBook)
        {
            <div class="row justify-content-between mt-4 mt-md-0">
                @* Status and Genre filter buttons *@
                <div class="col-auto">
                    <div class="d-flex flex-row align-items-end gap-3">
                        <label class="form-label d-none d-sm-block">Status:</label>
                        <select class="form-select" aria-label="Default select example" @onchange="FilterBooks">
                            <option value="" selected>All</option>
                            <option value="ToRead">To Read</option>
                            <option value="Reading">Reading</option>
                            <option value="Finished">Finished</option>
                        </select>
                    </div>
                </div>
                @* Add Book button *@
                <div class="col-auto">
                    <button type="button" class="btn btn-success addBookBtn" @onclick="ShowEditBook">
                        <span class="d-flex gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor"
                                 class="bi bi-plus" viewBox="0 0 16 16">
                                <path
                                d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                            </svg>
                            <span class="d-none d-sm-block">Add Book</span>
                        </span>
                    </button>
                </div>
            </div>

            @* User Library *@
            @if(UserBooks?.Count() == 0)
            {
                <span>Library is empty.</span>
            } 
            else 
            {
                <UserLibrary UserBooks="FilteredUserBooks ?? UserBooks" OnUpdateLibrary="GetUserBooksAsync" />
            }

        }
        else if (isSearchingBook)
        {
            <EditBook OnReturnToLibrary="ToggleShowLibrary" OnBookSelect="HandleBookSelect" />
        } 
        else if (isAddingBook) 
        {
            <AddBookForm Doc=SelectedDoc OnReturnToSearch="HandleReturnToSearch" OnSubmitBook="ToggleShowLibrary" />
        }

    </div>
</div>

@code {

    private List<BookDto>? UserBooks { get; set; }
    private List<BookDto>? FilteredUserBooks { get; set; }
    private string currentGenreFilter { get; set; } = "All";
    private OpenLibraryDoc? SelectedDoc { get; set; }
    private bool isShowingLibrary = true, isSearchingBook = false, isAddingBook = false;

    protected override async Task OnInitializedAsync()
    {
        UserBooks = new();
        await GetUserBooksAsync();
    }
    
    private async Task GetUserBooksAsync() {
        UserBooks = await _bookService.GetUserBooksAsync();
    }

    private void FilterBooks(ChangeEventArgs e)
    {
        string? filter = e.Value?.ToString();

        if (UserBooks is not null && string.IsNullOrEmpty(filter) == false) {

            FilteredUserBooks = UserBooks.Where(b => b.Status.ToString().Equals(filter)).ToList();

        } else {
            FilteredUserBooks = null;
        }        
    }

    private void HandleReturnToSearch() {
        isSearchingBook = true;
        isAddingBook = false;
    }

    private void ShowEditBook() {
        isShowingLibrary = false;
        isSearchingBook = true;
    }

    private void HandleBookSelect(OpenLibraryDoc doc) {
        SelectedDoc = doc;
        isSearchingBook = false;
        isAddingBook = true;
    }

    private async Task ToggleShowLibrary()
    {
        isSearchingBook = false;
        isAddingBook = false;
        isShowingLibrary = true;
        await GetUserBooksAsync();
        StateHasChanged();
    }
}
@using LibraryShared.dtos
@using LibraryTrackerApp.Services

@inject BookService _bookService

<div class="row mt-3 mb-3 g-3 justify-content-center justify-content-lg-start">
    @if (UserBooks is not null)
    {
        @foreach (var book in UserBooks)
        {
            <div class="col-auto">
                <BookCard Book=book OnRemoveBook="HandleBookRemove" />
            </div>
        }
    }
</div>

@code {

    [Parameter, EditorRequired]
    public required EventCallback OnUpdateLibrary { get; set; }

    [Parameter, EditorRequired]
    public required List<BookDto> UserBooks { get; set; }

    private async Task HandleBookRemove(BookDto dto) {
        await _bookService.RemoveBookFromLibraryAsync(dto);
        await OnUpdateLibrary.InvokeAsync();
    }
}
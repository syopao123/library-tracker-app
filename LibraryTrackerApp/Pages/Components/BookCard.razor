@using LibraryShared.dtos

@inject IJSRuntime _js

<div role="button" data-bs-toggle="modal" data-bs-target="#@Book.Id-modal" class="card rounded-3 p-0 text-decoration-none" id="bookCard-@Book.Id">

    <img src="@Book.ImageUrl" class="card-img-top" alt="No Image" />

    <div class="card-body">

        <div class="row pb-3">
            <div>
                @if (Book.Status.ToString().Equals("ToRead"))
                {
                    <span class="badge rounded-pill px-3 py-2 to-read">To Read</span>

                }
                else if (Book.Status.ToString().Equals("Reading"))
                {
                    <span class="badge rounded-pill px-3 py-2 reading">@Book.Status</span>
                }
                else if (Book.Status.ToString().Equals("Finished"))
                {
                    <span class="badge rounded-pill px-3 py-2 finished">@Book.Status</span>
                }
            </div>
        </div>

        <div class="card-title">
            <h5>@Book.Title</h5>
        </div>

    </div>

    <div class="card-footer">

        @if (Book.Rating > 0)
        {
            var userRating = Book.Rating;
            var remainingStars = 5 - userRating;

            @for (int i = 0; i < userRating; i++)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#f7d577" class="bi bi-star-fill"
                     viewBox="0 0 16 16">
                    <path
                    d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                </svg>
            }

            @for (int i = 0; i < remainingStars; i++)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#f7d577" class="bi bi-star"
                     viewBox="0 0 16 16">
                    <path
                    d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.56.56 0 0 0-.163-.505L1.71 6.745l4.052-.576a.53.53 0 0 0 .393-.288L8 2.223l1.847 3.658a.53.53 0 0 0 .393.288l4.052.575-2.906 2.77a.56.56 0 0 0-.163.506l.694 3.957-3.686-1.894a.5.5 0 0 0-.461 0z" />
                </svg>
            }

        }

    </div>
</div>

@* Modal *@
<div class="modal fade" id="@Book.Id-modal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="@Book.Id-modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Book Details</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="RestoreBookInfo"></button>
            </div>
            <div class="modal-body">
                <BookDetails Book="Book" @key="Book.Id" OnUpdateBook="HandleBookUpdate" OnDeleteBook="HandleBookRemove" OnDismissModal="DismissModal" />
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter, EditorRequired]
    public EventCallback<UpdateBookDto> OnUpdateBook { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<BookDto> OnRemoveBook { get; set; }

    [Parameter, EditorRequired]
    public BookDto Book { get; set; }

    private BookDto? OriginalBook { get; set; }

    protected override void OnInitialized()
    {
        StoreBookInfo();
    }

    private void StoreBookInfo() {
        OriginalBook = new() {
            Id = Book.Id,
            Title = Book.Title,
            CustomAuthor = Book.CustomAuthor,
            CoverI = Book.CoverI,
            ImageUrl = Book.ImageUrl,
            CustomGenre = Book.CustomGenre,
            Status = Book.Status,
            Rating = Book.Rating,
            PersonalNotes = Book.PersonalNotes,
            FirstPublishYear = Book.FirstPublishYear,
            PublishYears = Book.PublishYears,
            AuthorName = Book.AuthorName,
            Subjects = Book.Subjects
        };
    }

    private void RestoreBookInfo() {
        if (OriginalBook is not null) {
            Book.Id = OriginalBook.Id;
            Book.Title = OriginalBook.Title;
            Book.CustomAuthor = OriginalBook.CustomAuthor;
            Book.CoverI = OriginalBook.CoverI;
            Book.ImageUrl = OriginalBook.ImageUrl;
            Book.CustomGenre = OriginalBook.CustomGenre;
            Book.Status = OriginalBook.Status;
            Book.Rating = OriginalBook.Rating;
            Book.PersonalNotes = OriginalBook.PersonalNotes;
            Book.FirstPublishYear = OriginalBook.FirstPublishYear;
            Book.PublishYears = OriginalBook.PublishYears;
            Book.AuthorName = OriginalBook.AuthorName;
            Book.Subjects = OriginalBook.Subjects;
        }
    }

    private async Task HandleBookUpdate(UpdateBookDto dto) {
        await DismissModal(dto.Id);
        await OnUpdateBook.InvokeAsync(dto);
    }

    private async Task HandleBookRemove(Guid id) {
        await DismissModal(id);
        await OnRemoveBook.InvokeAsync(Book);
    }

    public async Task DismissModal(Guid id) => await _js.InvokeVoidAsync("dismissBootstrapModal", $"{id}-modal");

}
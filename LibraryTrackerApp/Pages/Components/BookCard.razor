@using LibraryShared.dtos
@using LibraryShared.enums

<a href='edit-book' class="card rounded-3 p-0 text-decoration-none">

    <img src="..." class="card-img-top" alt="@(Book.CoverI is null ? Book.Title : Book.CoverI)" />

    <div class="card-body">

        <div class="row pb-3">
            <div><span class="badge rounded-pill px-3 py-2 to-read">To Read</span></div>
        </div>

        <div class="card-title">
            <h5>@Book.Title</h5>
        </div>

    </div>

    <div class="card-footer pb-4 text-end">
        <button class="btn btn-success btn-sm rounded-3">
            Add Book
        </button>
    </div>
</a>

@code {

    [Parameter, EditorRequired]
    public BookDto Book { get; set; }

    [Parameter]
    public bool IsAddingBook { get; set; } = false;
}
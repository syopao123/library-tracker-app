@page "/edit-book"
@using LibraryShared.classes
@using LibraryShared.dtos
@using LibraryShared.enums
@using LibraryTrackerApp.Pages.Components
@using LibraryTrackerApp.Services

@inject NavigationManager _navManager
@inject BookService _bookService

<PageTitle>Edit Book</PageTitle>

<div class="p-5">

    <div class="row justify-content-center EditBookForm">

        @if (isAddingBook)
        {
            <div class="card p-5 border-0 rounded-4 shadow-sm" style="width: 60rem;">
                <div class="card-title">
                    <div class="d-flex align-items-center gap-3">
                        <NavLink href="/" class="text-black">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                                 class="bi bi-arrow-left" viewBox="0 0 16 16">
                                <path fill-rule="evenodd"
                                      d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" />
                            </svg>
                        </NavLink>
                        <span class="fs-5">
                            Add Book
                        </span>
                    </div>
                </div>
                <div class="card-body p-0 mt-4">

                    @if (BookSearchDto is not null)
                    {
                        <EditForm Model="BookSearchDto" OnValidSubmit="SubmitBookSearchAsync" FormName="BookSearchForm">
                            <DataAnnotationsValidator />
                            <div class="row mb-3">
                                <div class="col">
                                    <label for="title" class="form-label">Title</label>
                                    <InputText type="text" class="form-control" @bind-Value="BookSearchDto.Title"
                                               placeholder="e.g. The Wind-Up Bird Chronicle" />
                                    <ValidationMessage For="() => BookSearchDto.Title" class="mt-2 text-danger small" />
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col">
                                    <label for="author" class="form-label">Author</label>
                                    <InputText type="text" class="form-control" @bind-Value="BookSearchDto.Author"
                                               placeholder="e.g. Haruki Murakami" />
                                    <ValidationMessage For="() => BookSearchDto.Author" class="mt-2 text-danger small" />
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col">
                                    <label for="publishYear" class="form-label">Year Published</label>
                                    <InputNumber @bind-value="BookSearchDto.PublishYear" class="form-control"
                                                 max="@(DateTime.Now.Year)" />
                                    <ValidationMessage For="() => BookSearchDto.PublishYear" class="mt-2 text-danger small" />
                                </div>
                            </div>
                            <div class="row mt-5 justify-content-between">
                                <div class="col-auto">
                                    @if (isSearching)
                                    {
                                        <div class="spinner-border text-success" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    }
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-success" disabled="@isSearching">Search Book</button>
                                </div>
                            </div>
                        </EditForm>
                    }

                    @* Search Results *@
                    @if (SearchResults is not null)
                    {
                        <div class="row mt-5 pb-5 rounded-4 px-4 gap-4" id="searchResultsWindow">
                            <div class="col pt-4 ps-0">
                                <span class="text-dark fst-italic">We found @(SearchResults.Docs.Count() > 1 ? "multiple books" : "a book") matching with your search.
                                    Please confirm the book you're adding.</span>
                                </div>
                                @foreach (var doc in SearchResults.Docs)
                                {
                                    <div class="col-12 p-5 border bg-white shadow-sm rounded-4">
                                        <div class="row">
                                            <div class="col-auto p-0">
                                                @if (doc.CoverI is not null)
                                                {
                                                    <img src="https://covers.openlibrary.org/b/id/@(doc.CoverI)-S.jpg" alt="@doc.Title"
                                                         style="width: 5rem;" />
                                                }
                                                else
                                                {
                                                    <img src="..." alt="No Image" style="width: 5rem;" />
                                                }
                                            </div>
                                            <div class="col ps-5 my-auto">
                                                <div class="row justify-content-start">
                                                    <div class="col-auto p-0">
                                                        <span class="fw-bold fs-5">@doc.Title</span>
                                                    </div>
                                                </div>
                                                <div class="row mb-3 justify-content-start">
                                                    <div class="col-auto p-0">
                                                        @if (doc.PublishYears is not null) {
                                                            <span>@doc.PublishYears.ElementAt(0)</span>
                                                        }
                                                    </div>
                                                </div>
                                                @if (doc.AuthorName is not null)
                                                {
                                                    <div class="row justify-content-start gap-2">
                                                        @foreach (var author in doc.AuthorName)
                                                        {
                                                            <div class="col-auto p-0">
                                                                <span class="badge text-bg-secondary">@author</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <div class="col-auto p-0 my-auto">
                                                <button class="btn btn-success px-4" id="addBookButton">
                                                    This is it
                                                </button>
                                            </div>

                                        </div>
                                    </div>
                                }
                            </div>
                        }

                    </div>
                </div>
            }

        @if (Book is not null && isEditingBook)
        {
            <EditForm Model="Book" OnValidSubmit="Submit" FormName="EditBookForm" class="p-0 p-lg-5">
                <DataAnnotationsValidator />

                <div class="row mb-3">
                    <div class="col-12 col-lg-6">
                        <label for="newBookTitle" class="form-label">Title <span class="text-danger">*</span></label>
                        <InputText @bind-Value="Book.Title" class="form-control" id="newBookTitle"
                                   placeholder="e.g. The Wind-Up Bird Chronicle" />
                        <ValidationMessage For="@(() => Book.Title)" class="text-danger small mt-2" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12 col-lg-6">
                        <label for="newBookAuthor" class="form-label">Author <span class="text-danger">*</span></label>
                        <InputText @bind-Value="Book.Author" class="form-control" id="newBookAuthor"
                                   placeholder="e.g. Haruki Murakami" />
                        <ValidationMessage For="@(() => Book.Author)" class="text-danger small mt-2" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12 col-lg-6">
                        <label for="newBookImageUrl" class="form-label">Image Url</label>
                        <InputText @bind-Value="NewBookImageUrl" class="form-control" id="newBookImageUrl"
                                   placeholder="Enter book cover image url ..." />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-6 col-lg-3">
                        <label for="newBookGenre" class="form-label">Genre</label>
                        <InputSelect class="form-select" @bind-Value="Book.Genre">
                            <option value="" selected>Select a genre ...</option>
                            <option value="Fantasy">Fantasy</option>
                        </InputSelect>
                    </div>
                    <div class="col-6 col-lg-3">
                        <label for="newBookStatus" class="form-label">Status</label>
                        <InputSelect class="form-select" @bind-Value="Book.Status" @bind-Value:after="OnStatusChange">
                            <option value="@ReadingStatus.ToRead" selected>To Read</option>
                            <option value="@ReadingStatus.Reading">Reading</option>
                            <option value="@ReadingStatus.Finished">Finished</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12 col-lg-6">
                        <label for="newBookRating" class="form-label">Rating</label>
                        <InputSelect class="form-select" @bind-Value="Book.Rating" disabled="@isRatingDisabled">
                            <option value="" selected>Select a rating ...</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => Book.Rating)" class="text-danger small mt-2" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12 col-lg-6">
                        <label for="newBookPersonalNotes" class="form-label">Personal Notes</label>
                        <InputTextArea id="newBookPersonalNotes" @bind-Value="Book.PersonalNotes" class="form-control"
                                       rows="5" />
                    </div>
                </div>
                <div class="row">
                    @if (isEditingBook)
                    {
                        <div class="col-6 col-md-6 col-lg-3">
                            <button type="button" class="btn btn-danger" @onclick="DeleteBook">
                                Delete
                            </button>
                        </div>
                    }
                    <div class="col-6 col-md-6 col-lg-@(isEditingBook ? 3 : 6) d-flex gap-2 justify-content-end">
                        <button type="button" class="btn px-4 cancelBtn" @onclick="RedirectToHome">
                            Cancel
                        </button>
                        <button type="submit" class="btn px-3 saveBookBtn">
                            <div class="d-flex align-items-center gap-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                                     class="bi bi-floppy" viewBox="0 0 16 16">
                                    <path d="M11 2H9v3h2z" />
                                    <path
                                    d="M1.5 0h11.586a1.5 1.5 0 0 1 1.06.44l1.415 1.414A1.5 1.5 0 0 1 16 2.914V14.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 14.5v-13A1.5 1.5 0 0 1 1.5 0M1 1.5v13a.5.5 0 0 0 .5.5H2v-4.5A1.5 1.5 0 0 1 3.5 9h9a1.5 1.5 0 0 1 1.5 1.5V15h.5a.5.5 0 0 0 .5-.5V2.914a.5.5 0 0 0-.146-.353l-1.415-1.415A.5.5 0 0 0 13.086 1H13v4.5A1.5 1.5 0 0 1 11.5 7h-7A1.5 1.5 0 0 1 3 5.5V1H1.5a.5.5 0 0 0-.5.5m3 4a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5V1H4zM3 15h10v-4.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5z" />
                                </svg>
                                <span class="d-none d-lg-block">Save Book</span>
                            </div>
                        </button>
                    </div>
                </div>

                @if (message is not null) {
                    <div class="row text-center text-danger">
                        <div class="col">
                            <span>@message</span>
                        </div>
                    </div>
                }

            </EditForm>
        }
    </div>
</div>

@code {


    private BookSearchDto? BookSearchDto { get; set; }

    private OpenLibrarySearchResponse? SearchResults { get; set; }

    private bool isAddingBook = true;

    private bool isSearching = false;

    protected override void OnInitialized()
    {
        Book = new BookDto() {
            Title = "", Author = ""
        };
        ResetSearch();
    }

    private void ResetSearch() {
        BookSearchDto = new BookSearchDto() {
            Title = "", Author = ""
        };
    }

    private async Task SubmitBookSearchAsync() {
        isSearching = true;
        SearchResults = await _bookService.SearchBookAsync(BookSearchDto!);
        isSearching = false;
        // ResetSearch();
    }




    private BookDto? Book { get; set; }

    private string? NewBookImageUrl { get; set; }
    private string? message { get; set; }

    private bool isRatingDisabled = true;

    private bool isLoading = false, isEditingBook = false;



    private void RedirectToHome() {
        _navManager.NavigateTo(_navManager.BaseUri);
    }



    private void ResetBook() {
        Book = new BookDto {
            Title = "",
            Author = "",
            Rating = null
        };
        NewBookImageUrl = "";
    }

    private async Task Submit()
    {        
        // RedirectToHome();
    }

    private async Task DeleteBook()
    {

    }

    private string GetImageUrl() {

        bool isUri = Uri.TryCreate(NewBookImageUrl, UriKind.Absolute, out Uri? uriResult);

        bool imageIsValidUrl = isUri && (uriResult!.Scheme == Uri.UriSchemeHttp || uriResult.Scheme == Uri.UriSchemeHttps);

        if (imageIsValidUrl) {
            return NewBookImageUrl!;
        } else {
            return Book!.ImageUrl!;
        }
    }

    private void OnStatusChange()
    {
        if (Book!.Status == ReadingStatus.Finished)
        {
            isRatingDisabled = false;
        }
        else
        {
            isRatingDisabled = true;
            Book.Rating = null;
        }
    }



}
@using LibraryShared.classes
@using LibraryShared.dtos
@using LibraryTrackerApp.Pages.Components
@using LibraryTrackerApp.Services

@inject NavigationManager _navManager
@inject BookService _bookService

<div class="p-5">

    <div class="row justify-content-center EditBookForm">

        <div class="card p-5 border-0 rounded-4 shadow-sm" style="width: 60rem;">
            <div class="card-title">
                <div class="d-flex align-items-center gap-3">
                    <span class="text-black" role="button" @onclick="ReturnToLibrary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                             class="bi bi-arrow-left" viewBox="0 0 16 16">
                            <path fill-rule="evenodd"
                                  d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" />
                        </svg>
                    </span>
                    <span class="fs-5">
                        Search Book
                    </span>
                </div>
            </div>
            <div class="card-body p-0 mt-4">

                @if (BookSearchDto is not null)
                {
                    @* Search Book Form *@
                    <EditForm Model="BookSearchDto" OnValidSubmit="SubmitBookSearchAsync" FormName="BookSearchForm">
                        <DataAnnotationsValidator />
                        <div class="row mb-3">
                            <div class="col">
                                <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
                                <InputText type="text" class="form-control" @bind-Value="BookSearchDto.Title"
                                           placeholder="e.g. The Wind-Up Bird Chronicle" />
                                <ValidationMessage For="() => BookSearchDto.Title" class="mt-2 text-danger small" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label for="author" class="form-label">Author <span class="text-danger">*</span></label>
                                <InputText type="text" class="form-control" @bind-Value="BookSearchDto.Author"
                                           placeholder="e.g. Haruki Murakami" />
                                <ValidationMessage For="() => BookSearchDto.Author" class="mt-2 text-danger small" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label for="publishYear" class="form-label">Year Published</label>
                                <InputNumber @bind-value="BookSearchDto.PublishYear" class="form-control"
                                             max="@(DateTime.Now.Year)" />
                                <ValidationMessage For="() => BookSearchDto.PublishYear" class="mt-2 text-danger small" />
                            </div>
                        </div>
                        <div class="row mt-5 justify-content-between">
                            <div class="col-auto">
                                @if (isLoading)
                                {
                                    <div class="spinner-border text-success" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                }
                                @if (SearchResults is not null && SearchResults.NumFound == 0)
                                {
                                    <span class="text-danger small">No Books Found</span>
                                }
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-success searchBookBtn" disabled="@isLoading">Search Book</button>
                            </div>
                        </div>
                    </EditForm>
                }

                @* Search Results *@
                @if (SearchResults is not null && SearchResults.NumFound > 0)
                {
                    <div class="row mt-5 pb-5 rounded-4 px-4 gap-4 overflow-auto" id="searchResultsWindow" style="max-height: 40rem;">
                        <div class="col pt-4 ps-0">
                            <span class="text-dark fst-italic">
                                We found @(SearchResults.Docs.Count() > 1 ? "multiple books" : "a book") matching with your search.
                                Please confirm the book you're adding.
                            </span>
                        </div>
                        @foreach (var doc in SearchResults.Docs)
                        {
                            <BookSearchItem Doc=doc OnBookSelect="HandleBookSelect" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required EventCallback<AddBookDto> OnReturnToLibrary { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback<OpenLibraryDoc> OnBookSelect { get; set; }

    private BookSearchDto? BookSearchDto { get; set; }
    private OpenLibrarySearchResponse? SearchResults { get; set; }
    private bool isSearchingBook = true, isAddingBook = false;
    private bool isLoading = false;

    protected override void OnInitialized()
    {
        ResetSearch();
    }

    private void ResetSearch() {
        BookSearchDto = new BookSearchDto() {
            Title = "", Author = ""
        };
    }

    // Show add book form after selecting a book
    public void HandleBookSelect(OpenLibraryDoc doc) {
        isSearchingBook = false;
        isAddingBook = true;
        OnBookSelect.InvokeAsync(doc);
    }

    // Add book to user's library after editing details
    private async Task SubmitBookSearchAsync() {
        isLoading = true;
        SearchResults = await _bookService.SearchBookAsync(BookSearchDto!);
        isLoading = false;
    }

    private async Task ReturnToLibrary()
    {
        await OnReturnToLibrary.InvokeAsync();
    }

}
@page "/browse"
@using LibraryShared.dtos
@using LibraryTrackerApp.Pages.Components
@using LibraryTrackerApp.Services

@inject BrowserService _browserService
@inject BookService _bookService

<PageTitle>Browse Books</PageTitle>

<div class="container-fluid">
    @if (IsLoading)
    {
        <div class="row min-vh-100 align-items-center justify-content-center">
            <div class="spinner-border text-success" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="p-3 lg-5">

            <div class="row mt-5 gap-4">

                @* Navigation *@
                <div class="col-auto">
                    <div class="row flex-column g-4">
                        <div class="col-auto">
                            <div class="card rounded-4 border-0 shadow-sm" style="width: 20rem;">
                                <div class="card-body p-4">
                                    <p class="fs-5 fw-bold mb-1">Browse By</p>
                                    <ul class="list-unstyled list-group">
                                        <li class="btn text-start">Most Popular</li>
                                        <li class="btn text-start">Recently Added</li>
                                        <li class="btn text-start">Highest Rated</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        @* <div class="col-auto">
                            <div class="card rounded-4 border-0 shadow-sm" style="width: 20rem;">
                                <div class="card-body p-4">
                                    <p class="fs-5 fw-bold mb-1">Genres</p>
                                    <span
                                    class="badge rounded-pill text-bg-light fw-lighter px-3 py-2 border m-1">Fiction</span>
                                    <span
                                    class="badge rounded-pill text-bg-light fw-lighter px-3 py-2 border m-1">Non-Fiction</span>
                                    <span
                                    class="badge rounded-pill text-bg-light fw-lighter px-3 py-2 border m-1">Sci-Fi</span>
                                    <span
                                    class="badge rounded-pill text-bg-light fw-lighter px-3 py-2 border m-1">Fantasy</span>
                                    <span
                                    class="badge rounded-pill text-bg-light fw-lighter px-3 py-2 border m-1">Mystery</span>
                                    <span
                                    class="badge rounded-pill text-bg-light fw-lighter px-3 py-2 border m-1">Biography</span>
                                    <span class="badge rounded-pill text-bg-light fw-lighter px-3 py-2 border m-1">
                                        View All
                                    </span>
                                </div>
                            </div>
                        </div> *@
                        <div class="col-auto">
                            <div class="card rounded-4 border-0 shadow-sm" style="width: 20rem;">
                                <div class="card-body p-4">
                                    <div class="fs-5 fw-bold mb-3">
                                        <span>Community</span>
                                    </div>

                                    @if (CommunityBooks is not null && CommunityBooks.Count() > 0)
                                    {
                                        @foreach (var book in CommunityBooks)
                                        {
                                            <CommunityBook Book="book" />
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Main Content *@
                <div class="col-9">

                    @* Book of the Week *@
                    <div class="row mb-5">
                        <div class="card border-0 shadow-sm rounded-4" style="width: 90rem;">
                            <div class="card-body p-5">

                                @* Book of the Week *@
                                @if (TrendingBook is not null)
                                {
                                    <div class="row gap-5">

                                        <div class="col-auto">
                                            <img src="@TrendingBook.ImageUrl" alt="..." class="img-thumbnail rounded-4">
                                        </div>

                                        <div class="col d-flex flex-column">

                                            <div class="row mb-3">
                                                <div class="col">
                                                    <span class="text-success fw-bold">BOOK OF THE WEEK</span>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col">
                                                    <span class="fs-2 fw-bold">@TrendingBook.Title</span>
                                                </div>
                                            </div>

                                            <div class="row mb-3">
                                                <div class="col">
                                                    <span class="fw-lighter text-secondary fs-5">@(TrendingBook.AuthorNames?[0] ?? "")</span>
                                                </div>
                                            </div>

                                            <div class="row mb-3 d-flex flex-grow-1">
                                                <div class="col">
                                                    <div class="h-100">
                                                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Iste veniam similique aliquam culpa doloremque, id nihil in eos eum non laudantium tempore, repellendus placeat maxime amet enim fugiat. Esse, tenetur fugiat? Doloribus omnis non culpa. A excepturi similique harum, quidem quaerat eos! Commodi deserunt aperiam alias excepturi sapiente quisquam sit eius earum sed? Dolorem dolor est itaque. Voluptatum beatae distinctio recusandae iste provident ipsum accusamus! Quibusdam itaque consequuntur nobis asperiores assumenda sequi dolor fugiat qui corporis, cumque optio ducimus! Quibusdam quaerat quia iste modi delectus, architecto harum exercitationem laboriosam nisi! Quia, excepturi totam? Consequatur expedita earum maxime neque dolorum accusantium!
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row justify-content-end">
                                                <div class="col-auto d-flex gap-2">
                                                    @if (!TrendingBook.IsOwnedByUser)
                                                    {
                                                        <button type="button" class="btn btn-success" @onclick="() => HandleAddToLibrary(TrendingBook)">Add to Library</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>


                                    </div>
                                }

                            </div>
                        </div>
                    </div>

                    @* Popular Right Now *@
                    <div class="row mb-3">
                        <div class="col d-flex justify-content-between">
                            <span class="fw-bold fs-5">Popular Right Now</span>
                            <span class="text-success">
                                View all
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8" />
                                </svg>
                            </span>
                        </div>
                    </div>
                    <div class="row mb-5 gap-3">

                        @if (PopularBooks is not null && PopularBooks.Count() > 0)
                        {
                            @foreach (var book in PopularBooks)
                            {
                                <PopularBook Book="book" OnAddToLibrary="HandleAddToLibrary" />
                            }
                        }

                    </div>
                </div>
            </div>

        </div>
    }
</div>


@code {
    private List<CommunityBookDto>? CommunityBooks { get; set; }
    private List<PopularBookDto>? PopularBooks { get; set; }
    private PopularBookDto? TrendingBook { get; set; }

    private bool IsLoading = false;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        await Task.Delay(1000);
        CommunityBooks = await _browserService.GetCommunityBooksAsync() ?? new();
        PopularBooks = await _browserService.GetPopularBooksAsync(4) ?? new();
        TrendingBook = PopularBooks.ElementAt(0);
        IsLoading = false;
    }

    public async Task HandleAddToLibrary(PopularBookDto dto)
    {
        var authorNames = dto.AuthorNames;

        @* TODO: Redo AuthorNames & CustomAuthor check *@
        AddBookDto addBook = new()
        {
            Title = dto.Title,
            OpenLibraryKey = dto.OpenLibraryKey,
            AuthorNames = authorNames is null ? new() : authorNames,
            CustomAuthor = authorNames is not null ? authorNames[0] : "No Author"
        };

        await _bookService.AddBookAsync(addBook);
    }

}